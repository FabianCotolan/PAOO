#include "FootballPlayer.h"
#include "FootballTeam.h"
#include <memory>
#include <thread>

void teamMatchSimulation(std::shared_ptr<FootballPlayer> player1, std::shared_ptr<FootballPlayer> player2);

int main() {
    FootballTeam barcelona("Lionel Messi", 30);
    FootballTeam real("Cristiano Ronaldo", 25);

    barcelona.usePlayer();
    real.usePlayer();

    barcelona.incrementPlayerGoals();
    real.incrementPlayerGoals();

    barcelona.usePlayer();
    real.usePlayer();

    auto barcelonaPlayer = std::make_shared<FootballPlayer>("Pedri", 10);
    auto realPlayer = std::make_shared<FootballPlayer>("Vinicius Jr.", 12);

    std::thread match1(teamMatchSimulation, barcelonaPlayer, realPlayer);
    std::thread match2(teamMatchSimulation, realPlayer, barcelonaPlayer);

    match1.join();
    match2.join();

    return 0;
}

void teamMatchSimulation(std::shared_ptr<FootballPlayer> player1, std::shared_ptr<FootballPlayer> player2) {
    static std::mutex matchMutex;
    std::lock_guard<std::mutex> lock(matchMutex);

    player1->addGoals();
    player2->addGoals();

    player1->displayInfo();
    player2->displayInfo();
}
